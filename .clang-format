---
# Foundation — clang-format
#
# Option version: LLVM/Clang **19** (same family as Debian stable / trixie).
#
# Install the tool:
#   - Debian stable: `apt install clang-format`  → clang-format-19
#   - Windows MinGW (MSYS2 ucrt64, Foundation toolchain):
#       pacman -S mingw-w64-ucrt-x86_64-clang
#       PATH: C:/msys64/ucrt64/bin  (already prefixed by tools/Build_Gen.bat in mingw64)
#       binary: clang-format.exe (e.g. 22.x on current ucrt64 — options ≥19 OK)
#       helper: tools\ClangFormat.bat  (dry-run) / tools\ClangFormat.bat -i  (writes)
# compile_commands.json: enabled by default (CMAKE_EXPORT_COMPILE_COMMANDS) under Make/Ninja/MinGW.
# Do not use the LLVM bundle shipped with VS2019 (clang 12): invalid options
#   (SortIncludes: CaseSensitive, LineEnding, ReferenceAlignment, …).
#
# Naming conventions (not enforced here — see .clang-tidy):
#   - Named constants / constexpr: PascalCase (SramSyncRetries, KindReq)
#   - Local variables / parameters: camelCase (maxDepth, switches — partial debt, case by case)
#   - Members: prefix _ + camelCase (_root, _mutex)
#   - No k prefix
#
# Include ordering (SortIncludes + IncludeCategories):
#   0. Main header of the .cpp (IncludeIsMainRegex — outside categories)
#   1. Same-folder local headers ("Foo.h", without '/')
#   2. Foundation project headers ("tools/...", "driver/...", …)
#   3. Fetch / sibling / third-party libraries (mcp2221a, esplora, boost, spdlog, nlohmann, sqlite3, libusb)
#   4. STL / system headers (<atomic>, <memory>, …)
# Project "..." headers stay before STL: every project header must be self-contained.
#
# Style observed in the current code: Allman, C++17, 4 spaces, left pointers,
# ColumnLimit 0, init-list after ':'.

Language: Cpp
Standard: c++17

BasedOnStyle: LLVM

AccessModifierOffset: -4
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: Consecutive
AlignOperands: Align
AlignTrailingComments: true
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlwaysBreakTemplateDeclarations: MultiLine
BinPackArguments: false
BinPackParameters: false
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
BreakBeforeBraces: Allman
BreakConstructorInitializers: AfterColon
ColumnLimit: 0
CompactNamespaces: false
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4
Cpp11BracedListStyle: true
DerivePointerAlignment: false
FixNamespaceComments: true
IncludeBlocks: Regroup
IncludeCategories:
  # Locaux same-dir (après le main header géré par IncludeIsMainRegex)
  - Regex: '^"[^/]+\.h(pp)?"$'
    Priority: 1
  # Projet Foundation (trampoline build/include)
  - Regex: '^"(actsens|driver|io|protocol|sample|tools|util)/'
    Priority: 2
  # Libs siblings / Description.xml fetch
  - Regex: '^"(mcp2221a|esplora)/'
    Priority: 3
  - Regex: '^<(mcp2221a|esplora|libusb)/'
    Priority: 3
  # Tierces courantes
  - Regex: '^"(boost|nlohmann|spdlog)/'
    Priority: 3
  - Regex: '^<(boost|spdlog|nlohmann)/'
    Priority: 3
  - Regex: '^<sqlite3\.h>$'
    Priority: 3
  # STL / système
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 5
IncludeIsMainRegex: '([-_](test|tests))?$'
IndentCaseLabels: true
IndentCaseBlocks: true
IndentWidth: 4
InsertTrailingCommas: None
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
NamespaceIndentation: None
PointerAlignment: Left
ReferenceAlignment: Pointer
ReflowComments: true
SortIncludes: CaseSensitive
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1
SpacesInAngles: Never
SpacesInContainerLiterals: true
TabWidth: 4
UseTab: Never

# Windows sources (CRLF). On Debian CI, clang-format-19 honors LineEnding.
LineEnding: CRLF
